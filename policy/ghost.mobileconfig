<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ghost's policy for the Macs of an organisation, as a configuration profile.

  Change the values below, give the profile identifiers and UUIDs of your
  own, and deploy it from your MDM (as a custom profile, or as a "Custom
  Settings" payload for the domain local.ghost.desk), or install it by hand
  in System Settings > General > Device Management. Ghost reads it as it
  starts, through CFPreferences: only values a profile forces count, so
  nobody sets a policy with `defaults write`.

  A profile that does not read (a value of the wrong kind, a setting Ghost
  does not have, a limit it does not know) keeps Ghost's settings from
  loading until it is put right: nothing runs half governed.
-->
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <!-- The preference domain Ghost reads: Ghost.app's bundle identifier. -->
      <key>PayloadType</key>
      <string>local.ghost.desk</string>
      <key>PayloadIdentifier</key>
      <string>com.example.ghost.policy.local.ghost.desk</string>
      <key>PayloadUUID</key>
      <string>68B26282-094B-42B0-99A7-1E5B4E034581</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadDisplayName</key>
      <string>Ghost</string>

      <!-- Who sets the policy (required): said beside each setting it locks. -->
      <key>organization</key>
      <string>Example Corp</string>

      <!-- Where to ask about it (optional). -->
      <key>support_url</key>
      <string>https://it.example.com/ghost</string>

      <!--
        settings (optional): top-level keys of ~/.ghost/settings.json, each a
        dict of
          value   the setting's value, of its own kind (true or false, an
                  integer, a string, an array, a dict);
          locked  true: the value holds whatever the person chooses, and its
                  control is shown disabled with who manages it; false or
                  left out: the value is only the default where the person
                  has chosen nothing.
      -->
      <key>settings</key>
      <dict>
        <!-- How much Ghost tells the people who make it; 0 is nothing. -->
        <key>telemetry</key>
        <dict>
          <key>value</key>
          <integer>0</integer>
          <key>locked</key>
          <true/>
        </dict>
        <!-- Whether Ghost looks for its own updates. -->
        <key>check_updates</key>
        <dict>
          <key>value</key>
          <false/>
          <key>locked</key>
          <true/>
        </dict>
        <!-- What the branches Ghost makes begin with. -->
        <key>branch_prefix</key>
        <dict>
          <key>value</key>
          <string>corp/</string>
          <key>locked</key>
          <false/>
        </dict>
      </dict>

      <!--
        limits (optional): what no setting undoes, each enforced by Ghost's
        server where the thing is done. A limit left out limits nothing.
      -->
      <key>limits</key>
      <dict>
        <!-- The only agents that start, by their ACP registry id. -->
        <key>agents</key>
        <array>
          <string>claude-acp</string>
          <string>codex-acp</string>
        </array>
        <!-- false: no other device links to this Mac (Ghost does not listen). -->
        <key>remote</key>
        <false/>
        <!-- false: no cloudflared tunnel reaches this Mac. -->
        <key>tunnel</key>
        <false/>
        <!-- false: no scheduled task runs on a webhook. -->
        <key>webhooks</key>
        <false/>
      </dict>
    </dict>
  </array>
  <key>PayloadDisplayName</key>
  <string>Ghost policy</string>
  <key>PayloadDescription</key>
  <string>Settings and limits for Ghost, set by your organisation.</string>
  <key>PayloadIdentifier</key>
  <string>com.example.ghost.policy</string>
  <key>PayloadOrganization</key>
  <string>Example Corp</string>
  <key>PayloadScope</key>
  <string>System</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>ACA108B9-F331-46D1-93A6-01165F6D8BAE</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
