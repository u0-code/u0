# Copy to `.env` (ignored by git) and fill in only what you use. ghostd, the
# presences and ghost-work read it at start, from the directory they run in
# or one above. A variable already set in your shell takes precedence.
# Keys go here or in your environment: never in ghostd.toml, never in a commit.

# Brains (which provider reads which: Configuration in crates/ghostd/README.md).
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Web search for her look-ups and her work (any one).
SEARXNG_URL=
BRAVE_API_KEY=

# The daemon, if it requires a token from presences.
GHOSTD_TOKEN=

# How requests leave this machine, for ghostd and every presence:
# "system" (HTTPS_PROXY and the rest, the default), "none", or an HTTP
# proxy such as http://127.0.0.1:7890; and the hosts, comma-separated, that
# never use it (*.deepseek.com is it and everything under it). These replace
# setting NO_PROXY by hand, and override [network] in ghostd.toml.
GHOST_PROXY=
GHOST_DIRECT=

# Presences.
QQBOT_APPID=
QQBOT_SECRET=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
ONEBOT_ENDPOINT=
ONEBOT_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
