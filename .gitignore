/target
*.db
*.db-wal
*.db-shm
/ghosts/*
!/ghosts/_template
# Where the desk's core was kept before it had a home of its own: a
# checkout that ran the desk then still has its configuration and its
# solver here, which a home takes in once and leaves where they are.
/desk/core/
# And before that.
/solver/ghostd.toml
/derived
.env
.DS_Store
/ghostd.toml
.claude/
# Local runtime files and existing private configuration.
/run
/models.json
/keeper.json
# Design documents and write-ups stay on the machine they were written on.
# Only READMEs are published.
/docs/
# How the work loop compares with other agents is measured locally, not
# published.
/bench/
