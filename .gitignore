/target
*.db
*.db-wal
*.db-shm
/ghosts/*
!/ghosts/_template
# The desk's core as you run it: the desk adds you as its operator and
# records the brain you pick in its ghostd.toml, and the solver is born
# beside its template. The example and the template are what is published.
/desk/core/ghostd.toml
/desk/core/ghostd.toml.moving
/desk/core/ghosts/*
!/desk/core/ghosts/_solver
# Where the core was kept before it moved under the desk: a checkout that
# ran the desk then may still have its configuration or its solver here.
/solver/ghostd.toml
/derived
.env
.DS_Store
/ghostd.toml
.claude/
# Local runtime files and existing private configuration.
/run
/models.json
/keeper.json
# Design documents and write-ups stay on the machine they were written on.
# Only READMEs are published.
/docs/
# How the work loop compares with other agents is measured locally, not
# published.
/bench/
