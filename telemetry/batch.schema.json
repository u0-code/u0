            "x86_64"
          ]
        },
        "id": {
          "description": "Random, made for this install.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "agents": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,63}$"
