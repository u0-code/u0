{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Batch",
  "description": "A batch of u0's telemetry: one of a level, every field of it and\nnothing more. The Worker checks each against its schema,\n`telemetry/batch.schema.json`.",
  "anyOf": [
    {
      "$ref": "#/$defs/Off"
    },
    {
      "$ref": "#/$defs/Basic"
    },
    {
      "$ref": "#/$defs/Usage"
    },
    {
      "$ref": "#/$defs/Detailed"
    }
  ],
  "$defs": {
    "Off": {
      "description": "What goes at Off: the first launch's, once ever.",
      "type": "object",
      "properties": {
        "level": {
          "const": 0
        },
        "version": {
          "type": "string",
          "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}[0-9A-Za-z.+-]{0,24}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "stable",
            "nightly",
            "dev"
          ]
        },
        "os": {
          "description": "`macos 26`, or `linux`.",
          "type": "string",
          "pattern": "^(macos \\d{1,3}|linux)$"
        },
        "arch": {
          "type": "string",
          "enum": [
            "aarch64",
            "x86_64"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "version",
        "commit",
        "channel",
        "os",
        "arch"
      ]
    },
